# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker
# Optional: database used by `npm test` (its name must contain "test")
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/expense_tracker_test

# Long random string, at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Optional tuning
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=600
RECURRING_CRON=*/15 * * * *
